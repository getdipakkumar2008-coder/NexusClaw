{
  "id": "discord",
  "name": "Discord channel",
  "version": "0.2.0",
  "kind": "code",
  "sdkRange": "^0.3.0",
  "entry": "index.mjs",
  "provides": ["channel:discord"],
  "permissions": {
    "network": ["discord.com", "gateway.discord.gg", "cdn.discordapp.com", "media.discordapp.net"],
    "secrets": ["bot_token"]
  },
  "configSchema": {
    "apiBase": { "type": "string", "maxLength": 200, "optional": true, "description": "Discord REST address; leave unset for Discord itself" }
  }
}
